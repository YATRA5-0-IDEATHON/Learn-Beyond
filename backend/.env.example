# Copy to .env and fill in. Never commit the real .env.
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OAuth (social login) — server-side secrets. Leave blank to disable a provider.
# Google: create credentials at https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:5173/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn: create an app at https://www.linkedin.com/developers/apps
#   Request the "Sign In with LinkedIn using OpenID Connect" product.
#   Authorized redirect URL: http://localhost:5173/oauth/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=


